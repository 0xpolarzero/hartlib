{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@brief/api-client": ["../../packages/api-client/src/index.ts"],
      "@brief/api-client/*": ["../../packages/api-client/src/*"],
      "@brief/config": ["../../packages/config/src/index.ts"],
      "@brief/config/*": ["../../packages/config/src/*"],
      "@brief/demo-data": ["../../packages/demo-data/src/index.ts"],
      "@brief/docs": ["../../packages/docs/src/index.ts"],
      "@brief/i18n": ["../../packages/i18n/src/index.ts"],
      "@brief/shared": ["../../packages/shared/src/index.ts"],
      "@brief/shared/*": ["../../packages/shared/src/*"],
      "@brief/source-ingestion": ["../../packages/source-ingestion/src/index.ts"],
      "@brief/ui": ["../../packages/ui/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "../../packages/api-client/src",
    "../../packages/config/src",
    "../../packages/demo-data/src",
    "../../packages/docs/src",
    "../../packages/i18n/src",
    "../../packages/shared/src",
    "../../packages/source-ingestion/src",
    "../../packages/ui/src"
  ]
}
