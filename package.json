{
  "name": "brief",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:web": "bun --filter @brief/web dev",
    "dev:api": "bun --filter @brief/api dev",
    "dev:worker": "bun --filter @brief/worker dev",
    "build": "bun run --filter '*' build",
    "check": "tsc -b --noEmit",
    "lint": "oxlint apps packages *.ts",
    "format": "oxfmt AGENTS.md README.md package.json tsconfig.json tsconfig.base.json vitest.config.ts playwright.config.ts apps packages docs/*.md",
    "format:check": "oxfmt --check AGENTS.md README.md package.json tsconfig.json tsconfig.base.json vitest.config.ts playwright.config.ts apps packages docs/*.md",
    "test": "bun run --filter '*' test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/bun": "1.3.13",
    "@types/node": "25.7.0",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.9"
  }
}
