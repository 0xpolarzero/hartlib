{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "useDefineForClassFields": true,
    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@hartlib/api-client": ["../../packages/api-client/src/index.ts"],
      "@hartlib/api-client/*": ["../../packages/api-client/src/*"],
      "@hartlib/config": ["../../packages/config/src/index.ts"],
      "@hartlib/config/*": ["../../packages/config/src/*"],
      "@hartlib/docs": ["../../packages/docs/src/index.ts"],
      "@hartlib/i18n": ["../../packages/i18n/src/index.ts"],
      "@hartlib/shared": ["../../packages/shared/src/index.ts"],
      "@hartlib/ui": ["../../packages/ui/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "../../packages/api-client/src",
    "../../packages/config/src",
    "../../packages/docs/src",
    "../../packages/i18n/src",
    "../../packages/shared/src",
    "../../packages/ui/src"
  ]
}
