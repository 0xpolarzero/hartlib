{
  "name": "@brief/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "bun --env-file=../../.env --env-file=../../.env.local src/db/migrate.ts",
    "db:reset": "bun --env-file=../../.env --env-file=../../.env.local src/db/reset.ts",
    "dev": "bun --env-file=../../.env --env-file=../../.env.local --watch src/index.ts",
    "start": "bun --env-file=../../.env --env-file=../../.env.local src/index.ts",
    "build": "tsc -b --noEmit",
    "test": "bunx --bun vitest run --root ../.. apps/worker/src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1075.0",
    "@brief/config": "workspace:*",
    "@brief/shared": "workspace:*",
    "@brief/source-ingestion": "workspace:*",
    "@earendil-works/pi-agent-core": "0.80.3",
    "@earendil-works/pi-ai": "0.80.3",
    "@effect/platform-bun": "4.0.0-beta.92",
    "@effect/sql-pg": "4.0.0-beta.92",
    "@sentry/bun": "10.62.0",
    "effect": "4.0.0-beta.92",
    "effect3": "npm:effect@3.21.4",
    "pdf-parse": "2.4.5",
    "smithers-orchestrator": "0.26.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
