{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@brief/config": ["packages/config/src/index.ts"],
      "@brief/demo-data": ["packages/demo-data/src/index.ts"],
      "@brief/source-ingestion": ["packages/source-ingestion/src/index.ts"],
      "@brief/shared": ["packages/shared/src/index.ts"],
      "@brief/ui": ["packages/ui/src/index.ts"]
    }
  }
}
